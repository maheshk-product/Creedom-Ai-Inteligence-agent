# ============================================================
# Trend Intelligence System - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit your real .env file to version control.

# ------------------------------------------------------------
# YouTube Data API v3
# Get your key at: https://console.cloud.google.com/
# Free quota: 10,000 units/day
# ------------------------------------------------------------
YOUTUBE_API_KEY=your_youtube_api_key_here

# ------------------------------------------------------------
# Instagram Graph API (optional)
# Get via: https://developers.facebook.com/
# Requires a Facebook app + Instagram Business account
# ------------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_USER_ID=your_instagram_user_id_here

# ------------------------------------------------------------
# Trending Topics / Hashtags to track (comma-separated)
# Example: fitness,travel,cooking,technology
# ------------------------------------------------------------
TRENDING_TOPICS=fitness,travel,cooking,technology

# ------------------------------------------------------------
# Storage Configuration
# Options: csv, json (default: csv)
# ------------------------------------------------------------
STORAGE_FORMAT=csv
DATA_DIR=data

# ------------------------------------------------------------
# Reporting Configuration
# EMAIL_RECIPIENT: where to send daily reports (optional)
# ------------------------------------------------------------
REPORT_DIR=reports
EMAIL_RECIPIENT=

# ------------------------------------------------------------
# Scheduling
# RUN_SCHEDULE: daily or weekly
# RUN_TIME: 24-hour format, e.g. "08:00"
# ------------------------------------------------------------
RUN_SCHEDULE=daily
RUN_TIME=08:00

# ------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR
# ------------------------------------------------------------
LOG_LEVEL=INFO
